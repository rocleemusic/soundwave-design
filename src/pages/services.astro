---
import Base from '../layouts/Base.astro';
import services from '../data/services.json';

const base = import.meta.env.BASE_URL;
const portfolioImages = [
  { file: 'WWE2K26-Hero-1280x720-c-default.jpg',                     label: 'WWE 2K26'          },
  { file: 'Indiana-Jones-no-text-1280x720-c-default.jpg',            label: 'Indiana Jones'     },
  { file: 'snap-1280x720-c-default.jpg',                             label: 'Marvel Snap'       },
  { file: 'OW2-Key-art-1280x720-c-default.png',                      label: 'The Outer Worlds 2'},
  { file: 'NBA-2K26-1280x720-c-default.png',                         label: 'NBA 2K26'          },
  { file: 'DND-1280x720-c-default.png',                              label: 'D&D: Sigil'        },
  { file: 'honor-of-kings-1280x720-c-default.jpg',                   label: 'Honor of Kings'    },
  { file: 'Fallout-76-Gone-fission-scaled-1280x720-c-default.avif',  label: 'Fallout 76'        },
  { file: 'spectre-1280x720-c-default.png',                          label: 'Spectre'           },
];
---
<Base title="Services" description="Full service audio co-development for games, trailers, and interactive media.">

  <header class="page-header">
    <div class="container">
      <div class="page-eyebrow">What We Do</div>
      <h1 class="page-title">Full Service Audio<br />Co-Development</h1>
    </div>
  </header>

  <div class="container">
    <div class="services-wrapper">

      <!-- Left: service list -->
      <div class="services-list">
        {services.map((s, i) => (
          <div class={`service-item${i === 0 ? ' active' : ''}`} id={s.slug}>
            <div class="service-meta">
              <span class="service-number">{s.id}</span>
              <span class="service-eyebrow">{s.eyebrow}</span>
            </div>
            <h2 class="service-title">{s.title}</h2>
            <p class="service-body">{s.body}</p>
            <ul class="service-bullets">
              {s.chips.map(chip => <li>{chip}</li>)}
            </ul>
            <a class="service-cta" href={`${base}/contact/?service=${s.slug}`}>Start a project</a>
          </div>
        ))}
      </div>

      <!-- Right: sticky image stack -->
      <div class="services-images">
        <div class="services-images-inner">
          {portfolioImages.map(img => (
            <div class="img-slot">
              <img src={`${base}/images/portfolio/${img.file}`} alt={img.label} width="1280" height="720" />
              <span class="img-slot-label">{img.label}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>

  <div class="cta-band">
    <div class="container">
      <h2>Ready to build something?</h2>
      <p>Tell us about your project and we'll find the right fit.</p>
      <a class="btn-primary" href={`${base}/contact/`}>Get in Touch</a>
    </div>
  </div>

</Base>

<style>
  .page-header { padding: 80px 0 64px; border-bottom: 1px solid #2a2318; }
  .page-eyebrow { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-bottom: 16px; }
  .page-title { font-size: clamp(32px, 4vw, 52px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; }

  .services-wrapper {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 0;
    align-items: start;
  }
  .services-list { border-right: 1px solid #2a2318; }

  .service-item {
    padding: 48px 56px 48px 48px;
    border-bottom: 1px solid #2a2318;
    border-left: 3px solid transparent;
    transition: border-color 0.2s, background 0.2s;
  }
  .service-item:hover, .service-item.active {
    border-left-color: var(--accent);
    background: rgba(201,165,90,0.03);
  }
  .service-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .service-number { font-size: 11px; letter-spacing: 0.15em; color: var(--accent-deep); }
  .service-eyebrow { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); }
  .service-title { font-size: clamp(22px, 2.5vw, 30px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 14px; }
  .service-body { font-size: 15px; line-height: 1.7; color: var(--text-muted); max-width: 560px; margin-bottom: 20px; }
  .service-bullets {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .service-bullets li {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid #2a2318;
    padding: 4px 10px;
    border-radius: 2px;
  }
  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .service-cta::after { content: "→"; }

  .services-images {
    position: sticky;
    top: 61px;
    height: calc(100vh - 61px);
    overflow: hidden;
    padding: 32px 40px 32px 32px;
  }
  .services-images-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    will-change: transform;
  }
  .img-slot {
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--surface);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
  }
  .img-slot img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%); }
  .img-slot-label {
    position: absolute;
    bottom: 8px; left: 10px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245,239,224,0.7);
    background: rgba(12,11,8,0.6);
    padding: 3px 8px;
    border-radius: 2px;
  }

  @media (max-width: 1024px) {
    .services-wrapper { grid-template-columns: 1fr; }
    .services-images { display: none; }
    .service-item { padding: 36px 24px; }
  }
</style>

<script>
  const PARALLAX_SPEED = 0.8;
  const wrapper = document.querySelector('.services-wrapper') as HTMLElement;
  const inner = document.querySelector('.services-images-inner') as HTMLElement;

  if (wrapper && inner) {
    function updateParallax() {
      const rect = wrapper.getBoundingClientRect();
      const progress = Math.max(0, Math.min(1, -rect.top / (wrapper.offsetHeight - window.innerHeight)));
      const maxShift = inner.scrollHeight - inner.parentElement!.clientHeight;
      inner.style.transform = `translateY(${-progress * maxShift * PARALLAX_SPEED}px)`;
    }
    window.addEventListener('scroll', updateParallax, { passive: true });
    updateParallax();
  }
</script>
